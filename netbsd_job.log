2026-09-15T22:48:59.1645011Z Exec SSH: #!/bin/sh
2026-09-15T22:48:59.1645558Z # Point pkg_add at live package mirrors for the running release.
2026-09-15T22:48:59.1646135Z #
2026-09-15T22:48:59.1646469Z # Two problems with the image's default /etc/pkg_install.conf:
2026-09-15T22:48:59.1646960Z #   - it ends with a 9.0 fallback, so when the preferred hosts miss a
2026-09-15T22:48:59.1647417Z #     package, pkg_add silently installs one built for NetBSD 9.0
2026-09-15T22:48:59.1647839Z #     (linked against libraries this release does not ship);
2026-09-15T22:48:59.1648286Z #   - cdn.NetBSD.org and ftp.NetBSD.org are the same infrastructure
2026-09-15T22:48:59.1648735Z #     behind a CDN, and they have been down together (2026-08-30).
2026-09-15T22:48:59.1649093Z #
2026-09-15T22:48:59.1649388Z # Probe every mirror and write ONLY the ones that answer, in order.
2026-09-15T22:48:59.1650061Z # Dead entries must not be kept as fallbacks: pkg_add walks the whole
2026-09-15T22:48:59.1650559Z # PKG_PATH list for every package it installs, and each dead https
2026-09-15T22:48:59.1651010Z # host costs minutes of TLS timeouts per package -- a 20-minute
2026-09-15T22:48:59.1651467Z # prepare step died exactly that way.  Never fail the VM start: if
2026-09-15T22:48:59.1651845Z # nothing answers, leave the file alone.
2026-09-15T22:48:59.1652136Z #
2026-09-15T22:48:59.1652440Z # ASK EACH MIRROR FOR THE NEWEST QUARTERLY IT ACTUALLY HAS, rather than
2026-09-15T22:48:59.1652934Z # using the rolling <release>/ alias.  Those aliases are unreliable, and
2026-09-15T22:48:59.1653433Z # on riscv64 they are what broke this action (netbsd-vm run 33459640344,
2026-09-15T22:48:59.1653860Z # 12 red legs).  Measured 2026-09-01 for riscv64/11.0:
2026-09-15T22:48:59.1654171Z #
2026-09-15T22:48:59.1654556Z #   mirror              <rel>/     <rel>_2026Q2/
2026-09-15T22:48:59.1654875Z #   cdn.NetBSD.org      302        200
2026-09-15T22:48:59.1655180Z #   ftp.NetBSD.org      302        200
2026-09-15T22:48:59.1655461Z #   ftp.fr.NetBSD.org   404        200
2026-09-15T22:48:59.1655747Z #   ftp.jaist.ac.jp     403        200
2026-09-15T22:48:59.1656091Z #   ftp.allbsd.org      200        404   <- only survivor, a 2025 tree
2026-09-15T22:48:59.1656441Z #
2026-09-15T22:48:59.1656737Z # So every good mirror failed the probe and PKG_PATH ended up holding
2026-09-15T22:48:59.1657199Z # only allbsd's stale set: rsync 3.4.1 where the image ships 3.4.4 (so
2026-09-15T22:48:59.1657665Z # `pkg_add rsync` refused with "A different version ... is already
2026-09-15T22:48:59.1658108Z # installed"), and a dependency set that could not satisfy curl
2026-09-15T22:48:59.1658552Z # ("no pkg found for 'libidn2>=2.3.3nb1'"), which failed the prepare
2026-09-15T22:48:59.1658984Z # step and with it the job.  The real 2026Q2 tree has 21562 packages
2026-09-15T22:48:59.1659426Z # including the matching rsync; the alias tree had 13264.  x86_64 was
2026-09-15T22:48:59.1659876Z # unaffected only because its alias still answers 200 there.
2026-09-15T22:48:59.1660223Z #
2026-09-15T22:48:59.1660500Z # netbsd-builder learned the same lesson in 2026-08 and its
2026-09-15T22:48:59.1660957Z # hooks/vm_postBuild.sh already bakes PKG_PATH this way -- listings do
2026-09-15T22:48:59.1661429Z # not lie about which directories exist, aliases do.  The alias is kept
2026-09-15T22:48:59.1661897Z # only as a per-mirror fallback, so a mirror that publishes just the
2026-09-15T22:48:59.1662350Z # alias (allbsd) still contributes instead of being dropped.
2026-09-15T22:48:59.1662608Z 
2026-09-15T22:48:59.1662719Z arch=$(uname -p)
2026-09-15T22:48:59.1662951Z rel=$(uname -r)
2026-09-15T22:48:59.1663087Z 
2026-09-15T22:48:59.1663616Z candidates="https://cdn.NetBSD.org https://ftp.NetBSD.org http://ftp.fr.NetBSD.org http://ftp.jaist.ac.jp https://ftp.allbsd.org"
2026-09-15T22:48:59.1664114Z 
2026-09-15T22:48:59.1664444Z # Newest "<rel>_YYYYQn" directory this mirror actually lists, else empty.
2026-09-15T22:48:59.1665125Z # base ftp(1) speaks plain http/https on every release this action runs.
2026-09-15T22:48:59.1665563Z newest_quarterly() {
2026-09-15T22:48:59.1665967Z   ftp -o - -q 20 "$1/pub/pkgsrc/packages/NetBSD/$arch/" 2>/dev/null \
2026-09-15T22:48:59.1666490Z     | grep -oE "${rel}_[0-9][0-9][0-9][0-9]Q[0-9]" \
2026-09-15T22:48:59.1666843Z     | sort \
2026-09-15T22:48:59.1667071Z     | tail -n 1
2026-09-15T22:48:59.1667326Z }
2026-09-15T22:48:59.1667578Z 
2026-09-15T22:48:59.1667680Z pkgpath=""
2026-09-15T22:48:59.1667900Z used=""
2026-09-15T22:48:59.1668120Z for base in $candidates; do
2026-09-15T22:48:59.1668406Z   dir=$(newest_quarterly "$base")
2026-09-15T22:48:59.1668779Z   [ -n "$dir" ] || dir="$rel"          # no quarterly listed; try the alias
2026-09-15T22:48:59.1669201Z   url="$base/pub/pkgsrc/packages/NetBSD/$arch/$dir"
2026-09-15T22:48:59.1669588Z   ftp -o /dev/null -q 15 "$url/" >/dev/null 2>&1 || continue
2026-09-15T22:48:59.1669940Z   if [ -z "$pkgpath" ]; then
2026-09-15T22:48:59.1670230Z     pkgpath="$url/All"
2026-09-15T22:48:59.1670634Z   else
2026-09-15T22:48:59.1670872Z     pkgpath="$pkgpath;$url/All"
2026-09-15T22:48:59.1671141Z   fi
2026-09-15T22:48:59.1671353Z   used="$used $base($dir)"
2026-09-15T22:48:59.1671601Z done
2026-09-15T22:48:59.1671731Z 
2026-09-15T22:48:59.1686245Z if [ -z "$pkgpath" ]; then
2026-09-15T22:48:59.1687090Z   echo "onStarted: no NetBSD package mirror answered; keeping the default /etc/pkg_install.conf" >&2
2026-09-15T22:48:59.1687786Z   exit 0
2026-09-15T22:48:59.1688076Z fi
2026-09-15T22:48:59.1688233Z 
2026-09-15T22:48:59.1688419Z echo "PKG_PATH=$pkgpath" > /etc/pkg_install.conf
2026-09-15T22:48:59.1689022Z echo "onStarted: live package mirrors:$used (release $rel, $arch)"
2026-09-15T22:48:59.1689526Z exit 0
2026-09-15T22:48:59.1689696Z 
