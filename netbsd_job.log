2026-09-15T23:00:42.0860209Z Exec SSH: #!/bin/sh
2026-09-15T23:00:42.0860667Z # Point pkg_add at live package mirrors for the running release.
2026-09-15T23:00:42.0861172Z #
2026-09-15T23:00:42.0861681Z # Two problems with the image's default /etc/pkg_install.conf:
2026-09-15T23:00:42.0862442Z #   - it ends with a 9.0 fallback, so when the preferred hosts miss a
2026-09-15T23:00:42.0863191Z #     package, pkg_add silently installs one built for NetBSD 9.0
2026-09-15T23:00:42.0863906Z #     (linked against libraries this release does not ship);
2026-09-15T23:00:42.0864848Z #   - cdn.NetBSD.org and ftp.NetBSD.org are the same infrastructure
2026-09-15T23:00:42.0865599Z #     behind a CDN, and they have been down together (2026-08-30).
2026-09-15T23:00:42.0866182Z #
2026-09-15T23:00:42.0866684Z # Probe every mirror and write ONLY the ones that answer, in order.
2026-09-15T23:00:42.0867363Z # Dead entries must not be kept as fallbacks: pkg_add walks the whole
2026-09-15T23:00:42.0867871Z # PKG_PATH list for every package it installs, and each dead https
2026-09-15T23:00:42.0868346Z # host costs minutes of TLS timeouts per package -- a 20-minute
2026-09-15T23:00:42.0868810Z # prepare step died exactly that way.  Never fail the VM start: if
2026-09-15T23:00:42.0869203Z # nothing answers, leave the file alone.
2026-09-15T23:00:42.0869515Z #
2026-09-15T23:00:42.0869841Z # ASK EACH MIRROR FOR THE NEWEST QUARTERLY IT ACTUALLY HAS, rather than
2026-09-15T23:00:42.0870351Z # using the rolling <release>/ alias.  Those aliases are unreliable, and
2026-09-15T23:00:42.0871127Z # on riscv64 they are what broke this action (netbsd-vm run 33459640344,
2026-09-15T23:00:42.0871598Z # 12 red legs).  Measured 2026-09-01 for riscv64/11.0:
2026-09-15T23:00:42.0871930Z #
2026-09-15T23:00:42.0872210Z #   mirror              <rel>/     <rel>_2026Q2/
2026-09-15T23:00:42.0872563Z #   cdn.NetBSD.org      302        200
2026-09-15T23:00:42.0872875Z #   ftp.NetBSD.org      302        200
2026-09-15T23:00:42.0873191Z #   ftp.fr.NetBSD.org   404        200
2026-09-15T23:00:42.0873504Z #   ftp.jaist.ac.jp     403        200
2026-09-15T23:00:42.0883958Z #   ftp.allbsd.org      200        404   <- only survivor, a 2025 tree
2026-09-15T23:00:42.0884739Z #
2026-09-15T23:00:42.0885214Z # So every good mirror failed the probe and PKG_PATH ended up holding
2026-09-15T23:00:42.0885995Z # only allbsd's stale set: rsync 3.4.1 where the image ships 3.4.4 (so
2026-09-15T23:00:42.0886747Z # `pkg_add rsync` refused with "A different version ... is already
2026-09-15T23:00:42.0887498Z # installed"), and a dependency set that could not satisfy curl
2026-09-15T23:00:42.0888239Z # ("no pkg found for 'libidn2>=2.3.3nb1'"), which failed the prepare
2026-09-15T23:00:42.0888854Z # step and with it the job.  The real 2026Q2 tree has 21562 packages
2026-09-15T23:00:42.0889341Z # including the matching rsync; the alias tree had 13264.  x86_64 was
2026-09-15T23:00:42.0889808Z # unaffected only because its alias still answers 200 there.
2026-09-15T23:00:42.0890171Z #
2026-09-15T23:00:42.0890465Z # netbsd-builder learned the same lesson in 2026-08 and its
2026-09-15T23:00:42.0890941Z # hooks/vm_postBuild.sh already bakes PKG_PATH this way -- listings do
2026-09-15T23:00:42.0891444Z # not lie about which directories exist, aliases do.  The alias is kept
2026-09-15T23:00:42.0891932Z # only as a per-mirror fallback, so a mirror that publishes just the
2026-09-15T23:00:42.0892392Z # alias (allbsd) still contributes instead of being dropped.
2026-09-15T23:00:42.0892659Z 
2026-09-15T23:00:42.0892769Z arch=$(uname -p)
2026-09-15T23:00:42.0893020Z rel=$(uname -r)
2026-09-15T23:00:42.0893161Z 
2026-09-15T23:00:42.0893619Z candidates="https://cdn.NetBSD.org https://ftp.NetBSD.org http://ftp.fr.NetBSD.org http://ftp.jaist.ac.jp https://ftp.allbsd.org"
2026-09-15T23:00:42.0894610Z 
2026-09-15T23:00:42.0894842Z # Newest "<rel>_YYYYQn" directory this mirror actually lists, else empty.
2026-09-15T23:00:42.0895359Z # base ftp(1) speaks plain http/https on every release this action runs.
2026-09-15T23:00:42.0895776Z newest_quarterly() {
2026-09-15T23:00:42.0896136Z   ftp -o - -q 20 "$1/pub/pkgsrc/packages/NetBSD/$arch/" 2>/dev/null \
2026-09-15T23:00:42.0896564Z     | grep -oE "${rel}_[0-9][0-9][0-9][0-9]Q[0-9]" \
2026-09-15T23:00:42.0896889Z     | sort \
2026-09-15T23:00:42.0897122Z     | tail -n 1
2026-09-15T23:00:42.0897359Z }
2026-09-15T23:00:42.0897477Z 
2026-09-15T23:00:42.0897582Z pkgpath=""
2026-09-15T23:00:42.0897803Z used=""
2026-09-15T23:00:42.0898035Z for base in $candidates; do
2026-09-15T23:00:42.0898329Z   dir=$(newest_quarterly "$base")
2026-09-15T23:00:42.0898726Z   [ -n "$dir" ] || dir="$rel"          # no quarterly listed; try the alias
2026-09-15T23:00:42.0899160Z   url="$base/pub/pkgsrc/packages/NetBSD/$arch/$dir"
2026-09-15T23:00:42.0899568Z   ftp -o /dev/null -q 15 "$url/" >/dev/null 2>&1 || continue
2026-09-15T23:00:42.0899940Z   if [ -z "$pkgpath" ]; then
2026-09-15T23:00:42.0900215Z     pkgpath="$url/All"
2026-09-15T23:00:42.0900465Z   else
2026-09-15T23:00:42.0900699Z     pkgpath="$pkgpath;$url/All"
2026-09-15T23:00:42.0900979Z   fi
2026-09-15T23:00:42.0901207Z   used="$used $base($dir)"
2026-09-15T23:00:42.0901470Z done
2026-09-15T23:00:42.0901588Z 
2026-09-15T23:00:42.0901698Z if [ -z "$pkgpath" ]; then
2026-09-15T23:00:42.0902167Z   echo "onStarted: no NetBSD package mirror answered; keeping the default /etc/pkg_install.conf" >&2
2026-09-15T23:00:42.0902656Z   exit 0
2026-09-15T23:00:42.0902876Z fi
2026-09-15T23:00:42.0902996Z 
2026-09-15T23:00:42.0903145Z echo "PKG_PATH=$pkgpath" > /etc/pkg_install.conf
2026-09-15T23:00:42.0903729Z echo "onStarted: live package mirrors:$used (release $rel, $arch)"
2026-09-15T23:00:42.0904126Z exit 0
2026-09-15T23:00:42.0904470Z 
