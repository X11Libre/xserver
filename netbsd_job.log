2026-09-15T22:55:06.4671394Z ##[group]Running onStarted hook: /home/runner/work/_actions/vmactions/netbsd-vm/v1.5.0/hooks/onStarted.sh
2026-09-15T22:55:06.4673188Z Exec SSH: #!/bin/sh
2026-09-15T22:55:06.4673762Z # Point pkg_add at live package mirrors for the running release.
2026-09-15T22:55:06.4674615Z #
2026-09-15T22:55:06.4675079Z # Two problems with the image's default /etc/pkg_install.conf:
2026-09-15T22:55:06.4675852Z #   - it ends with a 9.0 fallback, so when the preferred hosts miss a
2026-09-15T22:55:06.4676544Z #     package, pkg_add silently installs one built for NetBSD 9.0
2026-09-15T22:55:06.4677239Z #     (linked against libraries this release does not ship);
2026-09-15T22:55:06.4677973Z #   - cdn.NetBSD.org and ftp.NetBSD.org are the same infrastructure
2026-09-15T22:55:06.4678715Z #     behind a CDN, and they have been down together (2026-08-30).
2026-09-15T22:55:06.4679610Z #
2026-09-15T22:55:06.4680258Z # Probe every mirror and write ONLY the ones that answer, in order.
2026-09-15T22:55:06.4681051Z # Dead entries must not be kept as fallbacks: pkg_add walks the whole
2026-09-15T22:55:06.4681789Z # PKG_PATH list for every package it installs, and each dead https
2026-09-15T22:55:06.4682523Z # host costs minutes of TLS timeouts per package -- a 20-minute
2026-09-15T22:55:06.4683215Z # prepare step died exactly that way.  Never fail the VM start: if
2026-09-15T22:55:06.4683779Z # nothing answers, leave the file alone.
2026-09-15T22:55:06.4684213Z #
2026-09-15T22:55:06.4685648Z # ASK EACH MIRROR FOR THE NEWEST QUARTERLY IT ACTUALLY HAS, rather than
2026-09-15T22:55:06.4686386Z # using the rolling <release>/ alias.  Those aliases are unreliable, and
2026-09-15T22:55:06.4687370Z # on riscv64 they are what broke this action (netbsd-vm run 33459640344,
2026-09-15T22:55:06.4688022Z # 12 red legs).  Measured 2026-09-01 for riscv64/11.0:
2026-09-15T22:55:06.4688480Z #
2026-09-15T22:55:06.4688831Z #   mirror              <rel>/     <rel>_2026Q2/
2026-09-15T22:55:06.4689314Z #   cdn.NetBSD.org      302        200
2026-09-15T22:55:06.4689758Z #   ftp.NetBSD.org      302        200
2026-09-15T22:55:06.4690185Z #   ftp.fr.NetBSD.org   404        200
2026-09-15T22:55:06.4690605Z #   ftp.jaist.ac.jp     403        200
2026-09-15T22:55:06.4691133Z #   ftp.allbsd.org      200        404   <- only survivor, a 2025 tree
2026-09-15T22:55:06.4691669Z #
2026-09-15T22:55:06.4692144Z # So every good mirror failed the probe and PKG_PATH ended up holding
2026-09-15T22:55:06.4692906Z # only allbsd's stale set: rsync 3.4.1 where the image ships 3.4.4 (so
2026-09-15T22:55:06.4693632Z # `pkg_add rsync` refused with "A different version ... is already
2026-09-15T22:55:06.4694474Z # installed"), and a dependency set that could not satisfy curl
2026-09-15T22:55:06.4695191Z # ("no pkg found for 'libidn2>=2.3.3nb1'"), which failed the prepare
2026-09-15T22:55:06.4695890Z # step and with it the job.  The real 2026Q2 tree has 21562 packages
2026-09-15T22:55:06.4696617Z # including the matching rsync; the alias tree had 13264.  x86_64 was
2026-09-15T22:55:06.4697284Z # unaffected only because its alias still answers 200 there.
2026-09-15T22:55:06.4697817Z #
2026-09-15T22:55:06.4698226Z # netbsd-builder learned the same lesson in 2026-08 and its
2026-09-15T22:55:06.4698929Z # hooks/vm_postBuild.sh already bakes PKG_PATH this way -- listings do
2026-09-15T22:55:06.4699859Z # not lie about which directories exist, aliases do.  The alias is kept
2026-09-15T22:55:06.4700682Z # only as a per-mirror fallback, so a mirror that publishes just the
2026-09-15T22:55:06.4701147Z # alias (allbsd) still contributes instead of being dropped.
2026-09-15T22:55:06.4701412Z 
2026-09-15T22:55:06.4701522Z arch=$(uname -p)
2026-09-15T22:55:06.4701763Z rel=$(uname -r)
2026-09-15T22:55:06.4701906Z 
2026-09-15T22:55:06.4702364Z candidates="https://cdn.NetBSD.org https://ftp.NetBSD.org http://ftp.fr.NetBSD.org http://ftp.jaist.ac.jp https://ftp.allbsd.org"
2026-09-15T22:55:06.4702864Z 
2026-09-15T22:55:06.4703081Z # Newest "<rel>_YYYYQn" directory this mirror actually lists, else empty.
2026-09-15T22:55:06.4703582Z # base ftp(1) speaks plain http/https on every release this action runs.
2026-09-15T22:55:06.4703964Z newest_quarterly() {
2026-09-15T22:55:06.4704506Z   ftp -o - -q 20 "$1/pub/pkgsrc/packages/NetBSD/$arch/" 2>/dev/null \
2026-09-15T22:55:06.4704913Z     | grep -oE "${rel}_[0-9][0-9][0-9][0-9]Q[0-9]" \
2026-09-15T22:55:06.4705226Z     | sort \
2026-09-15T22:55:06.4705479Z     | tail -n 1
2026-09-15T22:55:06.4705697Z }
2026-09-15T22:55:06.4705812Z 
2026-09-15T22:55:06.4705914Z pkgpath=""
2026-09-15T22:55:06.4706130Z used=""
2026-09-15T22:55:06.4706354Z for base in $candidates; do
2026-09-15T22:55:06.4706637Z   dir=$(newest_quarterly "$base")
2026-09-15T22:55:06.4707018Z   [ -n "$dir" ] || dir="$rel"          # no quarterly listed; try the alias
2026-09-15T22:55:06.4707438Z   url="$base/pub/pkgsrc/packages/NetBSD/$arch/$dir"
2026-09-15T22:55:06.4708037Z   ftp -o /dev/null -q 15 "$url/" >/dev/null 2>&1 || continue
2026-09-15T22:55:06.4708391Z   if [ -z "$pkgpath" ]; then
2026-09-15T22:55:06.4708658Z     pkgpath="$url/All"
2026-09-15T22:55:06.4708894Z   else
2026-09-15T22:55:06.4709122Z     pkgpath="$pkgpath;$url/All"
2026-09-15T22:55:06.4709389Z   fi
2026-09-15T22:55:06.4709609Z   used="$used $base($dir)"
2026-09-15T22:55:06.4709855Z done
2026-09-15T22:55:06.4709968Z 
2026-09-15T22:55:06.4710077Z if [ -z "$pkgpath" ]; then
2026-09-15T22:55:06.4710539Z   echo "onStarted: no NetBSD package mirror answered; keeping the default /etc/pkg_install.conf" >&2
2026-09-15T22:55:06.4711013Z   exit 0
2026-09-15T22:55:06.4711220Z fi
2026-09-15T22:55:06.4711332Z 
2026-09-15T22:55:06.4711478Z echo "PKG_PATH=$pkgpath" > /etc/pkg_install.conf
2026-09-15T22:55:06.4712025Z echo "onStarted: live package mirrors:$used (release $rel, $arch)"
2026-09-15T22:55:06.4712404Z exit 0
2026-09-15T22:55:06.4712524Z 
